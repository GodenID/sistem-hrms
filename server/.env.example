# Salin menjadi .env (lokal) / isi sebagai Environment di Coolify.
# JANGAN commit file .env asli.

# --- Wajib ---
# Koneksi Postgres (Coolify: pakai connection string database Postgres kamu)
DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms
# PENTING: pakai nilai AUTH_SECRET yang SAMA dengan secret Pages lama
# supaya token login user yang sudah ada tetap valid.
AUTH_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Frontend yang boleh mengakses API (domain Pages, koma tanpa spasi)
CORS_ORIGIN=https://hrms.prasastigroup.id

# Port listen (Coolify otomatis inject PORT sendiri — biarkan default)
PORT=3000

# --- Foto profil (S3 Onidel, sama seperti sebelumnya) ---
S3_ENDPOINT=https://s3.ap-southeast-1.onidel.cloud
S3_BUCKET=hrmsprasastigroup
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Didit (opsional, sama seperti sebelumnya) ---
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# --- OneSignal (opsional) ---
ONESIGNAL_APP_ID=a0e23f3d-e5c3-4d05-b583-400940e6fe2f
ONESIGNAL_REST_API_KEY=
