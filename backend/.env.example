# Server
PORT=3001
NODE_ENV=development

# Database PostgreSQL (VPS)
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://hrms:CHANGE_ME@localhost:5432/hrms

# JWT untuk sesi login
JWT_SECRET=CHANGE_ME_generate_panjang
JWT_EXPIRES_IN=30d

# CORS: daftar origin frontend yang diizinkan (pisah dengan koma)
# Contoh: https://hrms.domain.com,http://localhost:5173
CORS_ORIGIN=*

# Admin awal yang dibuat otomatis saat pertama start (ubah sebelum deploy!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Didit Webhook
# Get DIDIT_WEBHOOK_SECRET from Business Console > API & Webhooks > Destinations
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret_here
# Set to "true" to bypass signature verification in development (NEVER in production)
DIDIT_SKIP_SIGNATURE_VERIFY=false

# Logging
LOG_LEVEL=info
# Where to write raw webhook bodies for debug (set to empty to disable)
DEBUG_BODY_LOG_PATH=./logs/webhook-bodies.log